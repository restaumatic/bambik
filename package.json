{
  "name": "bambik",
  "private": true,
  "scripts": {
    "build": "spago build -w",
    "dev": "node scripts/dev.mjs",
    "smoke": "node scripts/smoke/run.mjs",
    "api-docs": "spago docs --format markdown && node scripts/api-docs.mjs",
    "presentation": "marp doc/presentation-20min.md --pdf --allow-local-files && marp doc/presentation-20min.md",
    "demo-1": "parcel -p 1234 demo/1/index.html & spago bundle-app --main Main --to demo/1/bundle.js -w -l --path demo/1/**/*.purs",
    "bundle-demo-1": "spago bundle-app --minify --main Main --to demo/1/bundle.js --path \"demo/1/**/*.purs\"",
    "bundle-demo-7guis": "spago build --path \"demo/7guis/*/*.purs\" && node scripts/bundle-7guis.mjs",
    "bundle-demo-nguis": "spago build --path \"demo/nguis/*/*.purs\" && node scripts/bundle-nguis.mjs",
    "bundle-demos": "npm run bundle-demo-1 && npm run bundle-demo-7guis && npm run bundle-demo-nguis",
    "deploy-demo-1": "scp -r demo/1/ xyz:/var/www/html/bambik/demo/",
    "deploy-demo-7guis": "scp -r demo/7guis/ xyz:/var/www/html/bambik/demo/",
    "deploy-demo-nguis": "scp -r demo/nguis/ xyz:/var/www/html/bambik/demo/"
  },
  "dependencies": {
    "material-components-web": "^14.0.0"
  },
  "devDependencies": {
    "@marp-team/marp-cli": "^4.1.2",
    "esbuild": "0.25.1",
    "parcel": "^2.9.3",
    "purescript": "file:/home/eryk/mine/purescript-variant-pkg/purescript-0.15.16-variant.6.tgz",
    "spago": "^0.21.0"
  }
}
