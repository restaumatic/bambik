{
  "name": "bambik",
  "private": false,
  "license": "BSD-3-Clause",
  "scripts": {
    "build": "spago build -w",
    "dev": "node scripts/dev.mjs",
    "smoke": "node scripts/smoke/run.mjs",
    "api-docs": "spago docs --format markdown",
    "presentation": "marp doc/presentation-20min.md --pdf --allow-local-files && marp doc/presentation-20min.md",
    "bundle-demos": "spago build && node scripts/bundle.mjs",
    "deploy-demos": "scp -r demo/index.html demo/workflow.html demo/page.js demo/7guis/ demo/nguis/ xyz:/var/www/html/bambik/demo/",
    "check-view-model": "node scripts/check-view-model.mjs"
  },
  "dependencies": {
    "@fluentui/web-components": "^3.0.2",
    "@material/web": "^2.5.0",
    "@shoelace-style/shoelace": "^2.20.1",
    "material-components-web": "^14.0.0"
  },
  "devDependencies": {
    "@marp-team/marp-cli": "^4.1.2",
    "esbuild": "0.25.1",
    "purescript": "https://github.com/erykciepiela/purescript/releases/download/v0.15.16-variant.7/purescript-0.15.16-variant.7.tgz",
    "spago": "^0.21.0"
  },
  "overrides": {
    "tar": "^7.5.21",
    "brace-expansion": "^5.0.8",
    "@puppeteer/browsers": "^3.2.0"
  }
}
